<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.fuin.dsl.cqrs.contexts</groupId>
        <artifactId>cqrs-common</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>cqrs-common-model</artifactId>
    <!--
        The models are data, not code: nothing in this artifact ever belongs on a classpath, so it is a
        plain zip rather than a jar. There is no packaging that builds one, hence 'pom' plus an assembly
        - which is also why the models are read from 'src/main/model' by the descriptor instead of being
        copied as resources, a phase the 'pom' lifecycle does not have.
    -->
    <packaging>pom</packaging>

    <name>cqrs-common-model</name>
    <description>The reusable "common" CQRS DSL context (types, basics, constraints, exceptions),
        published as a plain zip holding the public '.cqrs' files under 'model/public/'</description>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-assembly-plugin</artifactId>
                <executions>
                    <execution>
                        <id>make-model-zip</id>
                        <phase>package</phase>
                        <goals>
                            <goal>single</goal>
                        </goals>
                        <configuration>
                            <!--
                                Without this the assembly id would become a classifier. For a 'pom'
                                project the plugin then attaches the zip as the artifact itself, with no
                                classifier - which is what the DSL resolves.
                            -->
                            <appendAssemblyId>false</appendAssemblyId>
                            <descriptors>
                                <descriptor>src/main/assembly/model.xml</descriptor>
                            </descriptors>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
