[
  {
    "name": "a bare Boolean attribute is the whole condition",
    "rule": "MustBeEnabled",
    "predicate": { "op": "attr", "attribute": "enabled" },
    "cases": [
      { "values": { "enabled": true }, "expected": true },
      { "values": { "enabled": false }, "expected": false }
    ]
  },
  {
    "name": "negation of a bare Boolean",
    "rule": "MustNotBeEnabled",
    "predicate": { "op": "not", "expr": { "op": "attr", "attribute": "enabled" } },
    "cases": [
      { "values": { "enabled": false }, "expected": true },
      { "values": { "enabled": true }, "expected": false }
    ]
  },
  {
    "name": "compared against absence",
    "rule": "MustBeAssigned",
    "predicate": {
      "op": "compare",
      "attribute": "assignedEntry",
      "operator": "ne",
      "right": { "kind": "null" }
    },
    "cases": [
      { "values": { "assignedEntry": "JOURNAL_ENTRY 7" }, "expected": true },
      { "values": { "assignedEntry": null }, "expected": false }
    ]
  },
  {
    "name": "compared against absence, the other way",
    "rule": "MustNotBeAssigned",
    "predicate": {
      "op": "compare",
      "attribute": "assignedEntry",
      "operator": "eq",
      "right": { "kind": "null" }
    },
    "cases": [
      { "values": { "assignedEntry": null }, "expected": true },
      { "values": { "assignedEntry": "JOURNAL_ENTRY 7" }, "expected": false }
    ]
  },
  {
    "name": "compared against a named value of an enumeration",
    "rule": "MustBeIgnored",
    "predicate": {
      "op": "compare",
      "attribute": "status",
      "operator": "eq",
      "right": { "kind": "value", "value": "IGNORED" }
    },
    "cases": [
      { "values": { "status": "IGNORED" }, "expected": true },
      { "values": { "status": "OPEN" }, "expected": false }
