<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.fuin.dsl.cqrs.contexts</groupId>
        <artifactId>cqrs-common</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>cqrs-common-model</artifactId>
    <packaging>jar</packaging>

    <name>cqrs-common-model</name>
    <description>The reusable "common" CQRS DSL context (types, basics, constraints, exceptions),
        published as an ordinary jar holding the '.cqrs' files under 'model/'</description>

    <build>

        <!--
            The models are the artifact. They go into 'model/' so the DSL can tell them apart from
            anything else the jar may carry, and the consuming editor or build reads them straight out
            of the jar in the local repository - nothing is ever unpacked.
        -->
        <resources>
            <resource>
                <directory>src/main/cqrs</directory>
                <targetPath>model</targetPath>
                <includes>
                    <include>**/*.cqrs</include>
                    <!--
                        The "SrcGen4J" hint points at these, and a consumer of this model runs them to
                        find out which Java package an imported type was generated into. They only work
                        if they travel with the models.
                    -->
                    <include>**/*.js</include>
                </includes>
            </resource>
        </resources>

    </build>

</project>
