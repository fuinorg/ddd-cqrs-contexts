<?xml version="1.0" encoding="UTF-8"?>
<srcgen4j-config xmlns="http://www.fuin.org/srcgen4j/commons/0.5.0"
	xmlns:xtext="http://www.fuin.org/srcgen4j/core/xtext/0.5.0"
	xmlns:emf="http://www.fuin.org/srcgen4j/core/emf/0.5.0">

	<variables>
		<!-- The cqrs files of the "common" context, read straight from the sibling module
		     (paths are relative to the reactor root where the build is executed).

		     This points at the parent of "public" and "private", not at either of them: the parser
		     descends into both, so Java is generated for the whole model while only the public part is
		     published. The ".js" files below it are skipped by the "cqrs" extension filter. -->
		<variable name="modelPath" value="cqrs-common/model/src/main/model" />
		<variable name="copyrightHeader" value="" />
		<variable name="jpa" value="false" />
		<variable name="jaxb" value="false" />
		<variable name="jaxb_elements" value="false" />
		<variable name="jsonb" value="false" />
		<!-- On, so an exception generated here can carry its data to a client: the data class is per
		     serialization framework, and Jackson is what the consuming applications use. -->
		<variable name="jackson" value="true" />
		<!-- Prefix of an exception's short identifier, the way "DDD4J" names that library. It becomes the
		     "code" of a refused command's result, so a refusal from here is as quotable as one from the
		     application that consumes it. -->
		<variable name="shortIdPrefix" value="CQRSCO" />
	</variables>

	<modules>
		<!-- Generate into this module itself. Paths are relative to the reactor root where the build is
		     executed (same as "modelPath" above), so this points at the "java" module directory; its
		     "src-gen/main/java" is added as a compile source root by the build-helper plugin. -->
		<module name="shared" path="cqrs-common/java" maven="true" />
	</modules>

	<parsers>
		<parser name="cqrsParser" class="org.fuin.srcgen4j.core.xtext.XtextParser">
			<config>
				<xtext:xtext-parser-config modelPath="${modelPath}" modelExt="cqrs"
										   setupClass="org.fuin.dsl.cqrs.CqrsDslStandaloneSetup" />
			</config>
		</parser>
	</parsers>

	<generators>

		<generator name="sharedGenerator" class="org.fuin.srcgen4j.core.emf.EMFGenerator" parser="cqrsParser">
			<config>
				<emf:emf-generator-config>

					<!-- Pseudo generator that only maps the external "types.cqrs" to Java types -->
					<emf:artifact-factory artifact="ExternalTypes" class="org.fuin.dsl.ddd.gen.resourceset.CtxExternalTypes" />

					<emf:artifact-factory artifact="valueObjectGen" class="org.fuin.dsl.ddd.gen.valueobject.CombinedValueObjectArtifactFactory" />
					<emf:artifact-factory artifact="validatorAnnotation" class="org.fuin.dsl.ddd.gen.constr.ValidatorAnnotationArtifactFactory" />
					<emf:artifact-factory artifact="validator" class="org.fuin.dsl.ddd.gen.constr.ValidatorArtifactFactory" />
					<emf:artifact-factory artifact="enum" class="org.fuin.dsl.ddd.gen.enumobject.EnumArtifactFactory" />
					<emf:artifact-factory artifact="exception" class="org.fuin.dsl.ddd.gen.except.ExceptionArtifactFactory" />
					<!-- What a refusal was about, so a form can show the message under the field it concerns. -->
					<emf:artifact-factory artifact="exceptionData" class="org.fuin.dsl.ddd.gen.except.ExceptionDataArtifactFactory" />
					<emf:artifact-factory artifact="pkginfo" class="org.fuin.dsl.ddd.gen.resourceset.PackageInfoArtifactFactory" />

				</emf:emf-generator-config>
			</config>

		</generator>
	</generators>

</srcgen4j-config>
